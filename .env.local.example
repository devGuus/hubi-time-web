# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase.
# NUNCA coloque a service_role key aqui - somente a chave publica (anon/publishable).
# O prefixo NEXT_PUBLIC_ e obrigatorio para o Next.js expor a variavel no navegador;
# isso e seguro para a chave anon, que foi desenhada para ser publica (a protecao
# real dos dados vem do Row Level Security no banco, nao do sigilo desta chave).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# Service role do Supabase (Settings > API > service_role secret) - NUNCA leva
# o prefixo NEXT_PUBLIC_. So o webhook do Mercado Pago usa, no servidor.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Mercado Pago (Suas integracoes > Credenciais de producao). O access token
# cria os pagamentos; o webhook secret valida que a notificacao veio mesmo do
# Mercado Pago (Suas integracoes > Webhooks > Assinatura secreta).
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
MERCADOPAGO_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET_AQUI
