# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase.
# NUNCA coloque a service_role key aqui - somente a chave publica (anon/publishable).
# O prefixo NEXT_PUBLIC_ e obrigatorio para o Next.js expor a variavel no navegador;
# isso e seguro para a chave anon, que foi desenhada para ser publica (a protecao
# real dos dados vem do Row Level Security no banco, nao do sigilo desta chave).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI
